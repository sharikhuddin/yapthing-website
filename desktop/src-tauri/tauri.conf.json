{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YapThing",
  "version": "0.1.0",
  "identifier": "com.sharkcorp.yapthing.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "YapThing",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "appimage",
      "deb"
    ]
  }
}
